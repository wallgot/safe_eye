# ============================================
# SAFE-EYE Git Ignore
# ============================================

# Python virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]

# Environment variables / API keys
.env
.env.*

# Allow .env.example to be uploaded to GitHub
!.env.example

# Streamlit secrets
.streamlit/secrets.toml

# Local database
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Test / cache files
.pytest_cache/
.mypy_cache/

# Local test data
/data/

# Personal backup files
*백업*.txt